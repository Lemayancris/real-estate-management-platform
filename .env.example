# PostgreSQL configuration for local development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/real_estate_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/real_estate_db?schema=public"

# Application settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_ENV="development"

# Optional third-party service credentials
MPESA_CONSUMER_KEY="your_consumer_key"
MPESA_CONSUMER_SECRET="your_consumer_secret"
MPESA_SHORTCODE="174379"
MPESA_PASSKEY="your_passkey"
MPESA_ENVIRONMENT="sandbox"
